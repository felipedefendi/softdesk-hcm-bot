node_modules/
dist/
# build do frontend (web/) - o Express serve daqui, mas a fonte de verdade
# agora e web/src/. Passa a ser artefato gerado, nao mais versionado a mao.
public/
.env
state/*.json
state/encaminhamentos.log
debug/
*.log
*.tsbuildinfo

# documentacao interna (planos, contexto de sessao, guia de estudo) - so uso local
# toda a pasta docs/ e ignorada; README.md publico fica na raiz
docs/

# ferramentas de IA (uso local, nao versionar)
CLAUDE.md
AGENTS.md
.claude/

# scripts descartaveis de teste/inspecao criados na raiz durante o desenvolvimento
teste-*.ts
inspecionar-*.ts

# agendamento antigo via Task Scheduler do Windows, com caminho local hardcoded -
# substituido pelo systemd timer na VM
executar-tarefa.cmd

# script de backup do state/ da VM pro PC - tem IP da VM e caminho local da chave SSH
backup-state.ps1

# chaves privadas, em qualquer circunstancia. Nao e paranoia: um ssh-keygen com
# caminho em barra invertida rodado no Git Bash (que trata \ como escape) gerou
# o par dentro desta pasta em vez de ~/.ssh, e o deploy usa git add -A.
*.key
*.pem
id_rsa*
id_ed25519*

# editor e sistema operacional
.vscode/
.idea/
.DS_Store
Thumbs.db
